repo_roots:
  - ~/Desktop
  - ~/Documents

cor:
  base_url: "http://127.0.0.1:8787"

borsasite:
  health_url: "https://example.com/api/health"
  database_url: ""  # opsiyonel, boşsa sadece HTTP health kullanılır

readbunny:
  database_url: "postgresql://user:password@db-host:5432/readbunny"

vault:
  path: "/path/to/vault"

maintenance:                    # Dalga F — hepsi OPSİYONEL, eksikse default kullanılır
  disk_threshold_percent: 90    # bu oranın üstünde dolu olan diskler uyarılır
  stale_process_hours: 6       # bu süreden uzun çalışan süreçler "unutulmuş" sayılır
  stale_git_days: 3             # kirli repoda bu günden eski değişiklik varsa uyarılır
  process_names: [ollama, uvicorn, node]   # izlenecek süreç adı kalıpları
  # disk_paths: []              # boşsa repo_roots, o da boşsa "/" kontrol edilir

# --- durum --json kaynakları (atlas / orkestra) ---
#
# İki blok da TAMAMEN OPSİYONEL: eksik ya da bozuk tipli olsa bile panel
# düşmez, o kaynağın kartı sabit bir hata koduyla "erişilemiyor" der.
# Kule bu araçları alt süreç olarak çağırır (`<komut> durum --json`),
# ağa çıkmaz, hiçbir şeyi değiştirmez — yalnızca SAYILARI okur.
#
# `komut` string ya da liste olabilir; liste tavsiye edilir (tırnaklama
# tuzağı yok). Yol bulunamazsa/süreç zaman aşımına uğrarsa ya da hata
# döndürürse sabit kod: komut_yok / zaman_asimi / bilinmeyen_hata.
# `zaman_asimi` saniye cinsindendir, bozuk/sıfır/negatifse 15sn kullanılır.
#
# Alt sürece kule'nin Telegram secret'ı (KULE_TELEGRAM_*) GEÇİRİLMEZ.

atlas:
  komut: ["atlas"]             # atlas kendi CLI'sini sunar
  zaman_asimi: 15

orkestra:
  komut: ["orkestra"]
  zaman_asimi: 15

# harita: panelden KALDIRILDI (kırık link/yetim için vault kartı kullanılır,
# yetim tanımı harita'yla aynıdır). `app/collectors/harita_status.py` duruyor;
# yeniden açmak için `app/aggregator.py`'ye tek satır + panel kartı gerekir.

# bagimlilik: pip/npm zafiyet taramasının rapor DOSYASI. Kule raporu
# YENIDEN ÜRETMEZ, sadece okur ve sayıları doğrular — hiçbir ağ çağrısı yok.
# Blok tamamen OPSİYONEL: eksikse/bozuksa kart "erişilemiyor" der ve
# Telegram'a uyarı GİTMEZ (henüz hiç tarama yapılmamış olabilir).
# ~ genişletilir. Dosya yoksa sabit kod: okunamadi. Bozuk/şema dışı: cikti_gecersiz.
bagimlilik:
  dosya: "~/.bagimlilik/son.json"

araclar:                     # panel araçları (atlas/orkestra/harita) ayarları
  bosta_kapat_dakika: 15     # 0 = otomatik kapatma kapalı

telegram:
  bot_token: ""   # boş bırak, env'den de okunabilir: KULE_TELEGRAM_BOT_TOKEN
  chat_id: ""     # KULE_TELEGRAM_CHAT_ID
